{%- liquid
  # Count how many blocks carry a real review, so the section can stay hidden
  # until at least one exists. A wall of "example" cards on a live site reads
  # as unfinished — to visitors and to ad review.
  assign real_count = 0
  for block in section.blocks
    unless block.settings.is_placeholder
      assign real_count = real_count | plus: 1
    endunless
  endfor
-%}

{% if real_count > 0 or request.design_mode %}
<section class="testimonials section full-width">
  <div class="section__inner">
    <div class="section__intro section__intro--center" data-animate>
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2 class="section__title">{{ section.settings.heading | default: 'O que dizem nossos clientes' }}</h2>
      {% if section.settings.description != blank %}
        <p class="section__description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="testimonials__grid">
      {% for block in section.blocks %}
        {% comment %} Example cards exist only for guidance inside the editor. {% endcomment %}
        {% if block.settings.is_placeholder and request.design_mode == false %}
          {% continue %}
        {% endif %}

        <figure class="testimonials__card card card--interactive" data-animate {{ block.shopify_attributes }}>
          {% if block.settings.is_placeholder %}
            <span class="testimonials__flag">Exemplo — some no site publicado</span>
          {% endif %}

          {%- assign rating = block.settings.rating | default: 5 | at_most: 5 | at_least: 1 -%}
          {% comment %}
            Display only — deliberately not clickable. A star widget the
            visitor can press implies a rating system that does not exist.
            The text label is what screen readers announce.
          {% endcomment %}
          <div class="testimonials__stars" role="img" aria-label="Avaliação: {{ rating }} de 5 estrelas">
            {% for i in (1..5) %}
              <span
                class="testimonials__star{% if i <= rating %} is-filled{% endif %}"
                style="--star-delay: {{ i | times: 90 }}ms"
                aria-hidden="true"
              >
                {{ 'icon-star.svg' | inline_asset_content }}
              </span>
            {% endfor %}
          </div>

          <span class="testimonials__quote" aria-hidden="true">&ldquo;</span>

          <blockquote class="testimonials__text">
            {{ block.settings.quote | default: 'Cole aqui uma avaliação real de cliente (Google, Instagram ou WhatsApp).' }}
          </blockquote>

          <figcaption class="testimonials__author">
            <span class="testimonials__name">{{ block.settings.author | default: 'Nome do cliente' }}</span>
            {% if block.settings.source != blank %}
              <span class="testimonials__source">{{ block.settings.source }}</span>
            {% endif %}
          </figcaption>
        </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% stylesheet %}
  .testimonials {
    background-color: var(--color-background);
  }
  .testimonials__grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .testimonials__card {
    position: relative;
    margin: 0;
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
  }
  .testimonials__flag {
    display: inline-block;
    align-self: flex-start;
    margin-bottom: 1rem;
    padding: 0.28rem 0.55rem;
    background-color: color-mix(in srgb, var(--color-ink) 8%, transparent);
    border: 1px dashed color-mix(in srgb, var(--color-ink) 30%, transparent);
    font-family: var(--font-heading--family);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-ink) 55%, transparent);
  }
  .testimonials__stars {
    display: flex;
    gap: 0.2rem;
    margin-bottom: 0.9rem;
  }
  .testimonials__star {
    display: inline-flex;
    width: 1.1rem;
    height: 1.1rem;
    color: color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
  .testimonials__star svg {
    width: 100%;
    height: 100%;
  }

  /* Filled stars pop in one after the other once the card is revealed.
     Scoped to .is-visible so the sequence starts when the card appears,
     not while it is still below the fold. */
  .testimonials__card .testimonials__star.is-filled {
    color: #f5b301;
  }
  .js .testimonials__card .testimonials__star.is-filled {
    opacity: 0;
    transform: scale(0.4);
  }
  .js .testimonials__card.is-visible .testimonials__star.is-filled {
    animation: star-pop 0.45s cubic-bezier(0.2, 1.4, 0.4, 1) forwards;
    animation-delay: var(--star-delay, 0ms);
  }

  @keyframes star-pop {
    from {
      opacity: 0;
      transform: scale(0.4) rotate(-25deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .testimonials__card .testimonials__star.is-filled {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  .testimonials__quote {
    font-family: var(--font-heading--family);
    font-size: 3.5rem;
    line-height: 0.6;
    color: var(--color-accent);
    /* Yellow on white needs a dark edge to stay visible */
    -webkit-text-stroke: 1px color-mix(in srgb, var(--color-ink) 22%, transparent);
  }
  .testimonials__text {
    margin: 1rem 0 0;
    font-size: 0.98rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }
  .testimonials__author {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
  }
  .testimonials__name {
    display: block;
    font-family: var(--font-heading--family);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.92rem;
  }
  .testimonials__source {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--color-ink) 52%, transparent);
  }

  @media (min-width: 40rem) {
    .testimonials__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Depoimentos",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto de destaque", "default": "Depoimentos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "O que dizem nossos clientes" },
    { "type": "textarea", "id": "description", "label": "Descrição" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Depoimento",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "unit": "★",
          "label": "Nota da avaliação",
          "info": "Use a nota real que o cliente deu no Google.",
          "default": 5
        },
        { "type": "textarea", "id": "quote", "label": "Depoimento" },
        { "type": "text", "id": "author", "label": "Nome do cliente" },
        { "type": "text", "id": "source", "label": "Origem", "info": "Ex.: Avaliação no Google" },
        {
          "type": "checkbox",
          "id": "is_placeholder",
          "label": "Marcar como exemplo",
          "info": "Mostra um aviso no card. Desmarque ao inserir uma avaliação real.",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Depoimentos",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
