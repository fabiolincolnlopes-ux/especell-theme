{% comment %}
  `full-width` makes these span the whole viewport. Without it the section
  grid confines them to the centre column and the page background shows
  through at both top corners. The inner wrappers keep their own max-width,
  so nothing inside moves.
{% endcomment %}
{% if section.settings.show_topbar %}
  <div class="topbar full-width">
    <div class="topbar__inner">
      <span class="topbar__note">{{ section.settings.topbar_text }}</span>

      <span class="topbar__contacts">
        {% if settings.phone_number != blank %}
          <a href="tel:{{ settings.phone_number | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' }}">
            {{ 'icon-phone.svg' | inline_asset_content }}
            {{ settings.phone_number }}
          </a>
        {% endif %}
        {% if settings.whatsapp_url != blank %}
          <a href="{% render 'whatsapp-link' %}" target="_blank" rel="noopener noreferrer">
            {{ 'icon-whatsapp.svg' | inline_asset_content }}
            WhatsApp
          </a>
        {% endif %}
      </span>
    </div>
  </div>
{% endif %}

{%- comment -%}
  Falls back to links pointing at the home page sections, so navigation works
  out of the box. Selecting a real menu in the section settings replaces it.
  Prefixed with routes.root_url so the anchors also work from inner pages.
{%- endcomment -%}
{%- liquid
  assign has_menu = false
  if section.settings.menu.links.size > 0
    assign has_menu = true
  endif
-%}

<header class="site-header full-width" data-site-header>
  <div class="site-header__inner">
    <a href="{{ routes.root_url }}" class="site-header__logo">
      {% if section.settings.logo %}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'eager' }}
      {% else %}
        <span class="site-header__logo-text">{{ shop.name | default: 'Especell' }}</span>
      {% endif %}
    </a>

    <nav class="site-header__nav">
      {% if has_menu %}
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}" class="site-header__nav-link">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}#servicos" class="site-header__nav-link">Serviços</a>
        <a href="{{ routes.root_url }}#lojas" class="site-header__nav-link">Lojas</a>
        <a href="{{ routes.root_url }}#faq" class="site-header__nav-link">Dúvidas</a>
      {% endif %}
    </nav>

    <a
      href="{% render 'whatsapp-link', url: section.settings.cta_url %}"
      class="btn btn--accent btn--sm site-header__cta"
      target="_blank"
      rel="noopener noreferrer"
    >
      {{ section.settings.cta_label | default: 'Agendar agora' }}
    </a>

    <button
      type="button"
      class="site-header__toggle"
      data-menu-toggle
      aria-expanded="false"
      aria-label="Abrir menu"
    >
      {{ 'icon-menu.svg' | inline_asset_content }}
    </button>
  </div>

  <div class="site-header__mobile" data-mobile-menu>
    <nav>
      {% if has_menu %}
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}#servicos">Serviços</a>
        <a href="{{ routes.root_url }}#lojas">Lojas</a>
        <a href="{{ routes.root_url }}#faq">Dúvidas</a>
      {% endif %}
      <a
        href="{% render 'whatsapp-link', url: section.settings.cta_url %}"
        class="btn btn--accent"
        target="_blank"
        rel="noopener noreferrer"
      >
        {{ section.settings.cta_label | default: 'Agendar agora' }}
      </a>
    </nav>
  </div>
</header>

{% stylesheet %}
  .topbar {
    /* A shade below the header so the two black bands stay distinguishable */
    background-color: #000;
    color: color-mix(in srgb, #fff 70%, transparent);
    font-size: 0.78rem;
    border-bottom: 1px solid color-mix(in srgb, #fff 8%, transparent);
  }
  .topbar__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: 0.55rem var(--page-margin);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .topbar__note {
    display: none;
  }
  .topbar__contacts {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-inline: auto;
  }
  .topbar__contacts a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }
  .topbar__contacts a:hover {
    color: var(--color-accent);
  }
  .topbar__contacts svg {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--color-accent);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-ink) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in srgb, #fff 10%, transparent);
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .site-header.is-scrolled {
    box-shadow: 0 12px 34px -20px rgb(0 0 0 / 80%);
    border-bottom-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
  }
  .site-header__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    height: 4.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .site-header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: #fff;
    flex-shrink: 0;
  }
  .site-header__logo img {
    max-height: 2.6rem;
    width: auto;
  }
  .site-header__logo-text {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 1.45rem;
    letter-spacing: 0.04em;
  }

  .site-header__nav {
    display: none;
    align-items: center;
    gap: 2.2rem;
    flex: 1;
    justify-content: center;
  }
  .site-header__nav-link {
    position: relative;
    text-decoration: none;
    color: color-mix(in srgb, #fff 88%, transparent);
    font-size: 0.88rem;
    font-weight: 600;
    padding-block: 0.35rem;
    transition: color 0.2s ease;
  }
  .site-header__nav-link:hover {
    color: #fff;
  }
  .site-header__nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    /* Grows from the left on the way in and retreats to the right on the
       way out, so the line reads as travelling rather than blinking. */
    transform-origin: right;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .site-header__nav-link:hover::after,
  .site-header__nav-link:focus-visible::after {
    transform-origin: left;
  }
  .site-header__nav-link:hover::after,
  .site-header__nav-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__cta {
    display: none;
    flex-shrink: 0;
  }
  .site-header__toggle {
    display: flex;
    background: none;
    border: none;
    padding: 0.25rem;
    cursor: pointer;
    color: #fff;
  }
  .site-header__toggle svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .site-header__mobile {
    display: none;
    border-top: 1px solid color-mix(in srgb, #fff 10%, transparent);
    background-color: var(--color-ink);
  }
  .site-header__mobile[data-open] {
    display: block;
  }
  .site-header__mobile nav {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.35rem var(--page-margin);
  }
  .site-header__mobile a {
    text-decoration: none;
    color: #fff;
    font-weight: 600;
  }
  .site-header__mobile .btn {
    color: var(--color-ink);
  }
  .site-header__mobile nav > .btn {
    align-self: flex-start;
  }

  @media (min-width: 48rem) {
    .topbar__note {
      display: inline;
    }
    .topbar__contacts {
      margin-inline: 0;
    }
    .site-header__nav,
    .site-header__cta {
      display: flex;
    }
    .site-header__toggle {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cabeçalho",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Botão principal"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto do botão",
      "default": "Agendar agora"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link do botão"
    },
    {
      "type": "header",
      "content": "Barra superior"
    },
    {
      "type": "checkbox",
      "id": "show_topbar",
      "label": "Mostrar barra superior",
      "default": true
    },
    {
      "type": "text",
      "id": "topbar_text",
      "label": "Aviso da barra superior",
      "default": "Assistência técnica especializada · 5 lojas em Curitiba e região"
    }
  ]
}
{% endschema %}
