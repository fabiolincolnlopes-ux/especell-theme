<section class="about section full-width" id="{{ section.settings.anchor_id | default: 'sobre' }}">
  <div class="section__inner about__inner">
    {% if section.settings.image or request.design_mode %}
    <div class="about__media" data-animate>
      {% if section.settings.image %}
        {%- assign about_alt = section.settings.image.alt | default: 'Equipe da Especell na assistência técnica em Curitiba' -%}
        <div class="media-frame about__frame">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: alt: about_alt, loading: 'lazy', sizes: '(min-width: 64rem) 45vw, 100vw', widths: '600, 900, 1200'
          }}
        </div>
      {% else %}
        <div class="media-frame about__frame">
          <div class="media-placeholder">Envie aqui uma foto da equipe ou da loja</div>
        </div>
      {% endif %}

      {% if section.settings.badge_value != blank %}
        <div class="about__badge">
          <span class="about__badge-value">{{ section.settings.badge_value }}</span>
          <span class="about__badge-label">{{ section.settings.badge_label }}</span>
        </div>
      {% endif %}
    </div>
    {% endif %}

    <div class="about__copy">
      <div data-animate>
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2 class="section__title">{{ section.settings.heading | default: 'Sobre nós' }}</h2>
      </div>

      {% if section.settings.body != blank %}
        <div class="about__body rte" data-animate>{{ section.settings.body }}</div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <ul class="about__points">
          {% for block in section.blocks %}
            <li class="about__point" data-animate {{ block.shopify_attributes }}>
              <span class="about__point-icon">{{ 'icon-shield.svg' | inline_asset_content }}</span>
              <span>
                <strong>{{ block.settings.title }}</strong>
                {% if block.settings.description != blank %}
                  <span class="about__point-text">{{ block.settings.description }}</span>
                {% endif %}
              </span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <a
          href="{{ section.settings.cta_url | default: '#' }}"
          class="btn btn--dark about__cta"
          data-animate
          data-magnetic
        >
          {{ section.settings.cta_label }}
          {{ 'icon-arrow-right.svg' | inline_asset_content }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .about {
    background-color: var(--color-background);
  }
  .about__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }
  .about__media {
    position: relative;
  }
  .about__frame {
    aspect-ratio: 4 / 3;
  }
  .about__badge {
    position: absolute;
    right: -0.5rem;
    bottom: -1.25rem;
    background-color: var(--color-accent);
    color: var(--color-ink);
    padding: 1rem 1.35rem;
    text-align: center;
    box-shadow: 0 14px 34px -20px rgb(0 0 0 / 60%);
  }
  .about__badge-value {
    display: block;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 2.1rem;
    line-height: 1;
  }
  .about__badge-label {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .about__body {
    margin-top: 1.35rem;
    font-size: 1.02rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-ink) 66%, transparent);
  }
  .about__body p + p {
    margin-top: 0.9rem;
  }

  .about__points {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .about__point {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    font-size: 0.95rem;
  }
  .about__point strong {
    display: block;
    font-family: var(--font-heading--family);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 0.95rem;
  }
  .about__point-text {
    display: block;
    margin-top: 0.2rem;
    color: color-mix(in srgb, var(--color-ink) 60%, transparent);
  }
  .about__point-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    background-color: var(--color-ink);
    color: var(--color-accent);
  }
  .about__point-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .about__cta {
    margin-top: 2.25rem;
  }

  @media (min-width: 64rem) {
    /* Single column when no image is set, so the text does not sit half-width */
    .about__inner:has(.about__media) {
      grid-template-columns: 1fr 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sobre nós",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "ID da âncora", "default": "sobre" },
    { "type": "text", "id": "eyebrow", "label": "Texto de destaque", "default": "Quem somos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Sobre nós" },
    { "type": "richtext", "id": "body", "label": "Texto" },
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "header", "content": "Selo sobre a imagem" },
    { "type": "text", "id": "badge_value", "label": "Número do selo" },
    { "type": "text", "id": "badge_label", "label": "Legenda do selo" },
    { "type": "header", "content": "Botão" },
    { "type": "text", "id": "cta_label", "label": "Texto do botão" },
    { "type": "url", "id": "cta_url", "label": "Link do botão" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Diferencial",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Diferencial" },
        { "type": "text", "id": "description", "label": "Descrição" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sobre nós",
      "blocks": [{ "type": "point" }, { "type": "point" }, { "type": "point" }]
    }
  ]
}
{% endschema %}
