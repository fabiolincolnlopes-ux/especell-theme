<section class="cta bg-ink full-width">
  <div class="fx-bg" aria-hidden="true">
    <div class="fx-grid"></div>
    <div class="cta__glow"></div>
  </div>

  <div class="cta__inner" data-animate>
    {% if section.settings.eyebrow != blank %}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}

    <h2 class="cta__title">{{ section.settings.heading | default: 'Fale agora com a gente' }}</h2>

    {% if section.settings.description != blank %}
      <p class="cta__description">{{ section.settings.description }}</p>
    {% endif %}

    <div class="cta__actions">
      {% if section.settings.button_label != blank %}
        <a
          href="{% render 'whatsapp-link', url: section.settings.button_url %}"
          class="btn btn--accent"
          data-magnetic
          target="_blank"
          rel="noopener noreferrer"
        >
          {{ 'icon-whatsapp.svg' | inline_asset_content }}
          {{ section.settings.button_label }}
        </a>
      {% endif %}
      {% if section.settings.secondary_label != blank %}
        <a href="{{ section.settings.secondary_url | default: '#' }}" class="btn btn--outline">
          {{ section.settings.secondary_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .cta {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 7vw, 6rem);
    text-align: center;
  }
  .cta__glow {
    position: absolute;
    top: -60%;
    left: 50%;
    width: min(50rem, 100%);
    aspect-ratio: 1;
    margin-left: min(-25rem, -50%);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 18%, transparent) 0%,
      transparent 62%
    );
    animation: cta-glow-drift 16s ease-in-out infinite alternate;
  }

  @keyframes cta-glow-drift {
    from {
      transform: translate3d(-6%, 0, 0) scale(1);
      opacity: 0.6;
    }
    to {
      transform: translate3d(6%, 4%, 0) scale(1.18);
      opacity: 1;
    }
  }
  .cta__inner {
    position: relative;
    max-width: 42rem;
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }
  .cta__title {
    margin-top: 1.25rem;
    font-size: clamp(1.9rem, 4.5vw, 3.1rem);
  }
  .cta__description {
    margin-top: 1.1rem;
    color: color-mix(in srgb, #fff 72%, transparent);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.25rem;
  }
  .cta__actions .btn--outline {
    color: #fff;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chamada para ação",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto de destaque" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Fale agora com a gente" },
    { "type": "textarea", "id": "description", "label": "Descrição" },
    { "type": "header", "content": "Botão principal" },
    { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Falar no WhatsApp" },
    { "type": "url", "id": "button_url", "label": "Link do botão" },
    { "type": "header", "content": "Botão secundário" },
    { "type": "text", "id": "secondary_label", "label": "Texto do botão" },
    { "type": "url", "id": "secondary_url", "label": "Link do botão" }
  ],
  "presets": [{ "name": "Chamada para ação" }]
}
{% endschema %}
