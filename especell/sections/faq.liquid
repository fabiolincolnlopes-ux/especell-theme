<section class="faq section full-width bg-muted" id="{{ section.settings.anchor_id | default: 'faq' }}">
  <div class="fx-bg" aria-hidden="true">
    <div class="fx-grid fx-grid--light"></div>
  </div>

  <div class="section__inner faq__inner">
    <div class="faq__intro" data-animate>
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2 class="section__title">{{ section.settings.heading | default: 'Dúvidas frequentes' }}</h2>
      {% if section.settings.description != blank %}
        <p class="section__description">{{ section.settings.description }}</p>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <a
          href="{% render 'whatsapp-link', url: section.settings.cta_url %}"
          class="btn btn--dark faq__cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          {{ section.settings.cta_label }}
        </a>
      {% endif %}
    </div>

    <div class="faq__list" data-accordion>
      {% for block in section.blocks %}
        <details class="faq__item" data-animate {{ block.shopify_attributes }}>
          <summary class="faq__question">
            <span>{{ block.settings.question | default: 'Pergunta' }}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__answer rte">
            {{ block.settings.answer | default: '<p>Resposta.</p>' }}
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% comment %}
  FAQPage markup lets Google show these questions expanded in the results.
  Answers are stripped of HTML because the spec expects plain text, and any
  question still carrying a fill-me placeholder is skipped — publishing
  "[Preencher]" as an answer would be worse than omitting it.
{% endcomment %}
{%- capture faq_json -%}
  {%- assign emitted = 0 -%}
  {%- for block in section.blocks -%}
    {%- assign answer = block.settings.answer | strip_html | strip -%}
    {%- unless block.settings.question == blank or answer == blank or answer contains 'Preencher' -%}
      {%- if emitted > 0 -%},{%- endif -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ answer | json }} }
      }
      {%- assign emitted = emitted | plus: 1 -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign faq_json = faq_json | strip -%}
{%- if faq_json != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [{{ faq_json }}]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .faq {
    position: relative;
    overflow: hidden;
  }
  .faq .section__inner {
    position: relative;
  }
  .faq__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  .faq__cta {
    margin-top: 1.75rem;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
  }
  .faq__item {
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
  }
  .faq__item:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
  }
  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.15rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    transition: color 0.25s ease;
  }
  .faq__question::-webkit-details-marker {
    display: none;
  }
  .faq__question:hover {
    color: color-mix(in srgb, var(--color-ink) 62%, transparent);
  }

  /* Plus sign that rotates into a minus when the answer opens */
  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    background-color: var(--color-accent);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background-color: var(--color-ink);
    transform: translate(-50%, -50%);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.25s ease;
  }
  .faq__icon::before {
    width: 0.7rem;
    height: 2px;
  }
  .faq__icon::after {
    width: 2px;
    height: 0.7rem;
  }
  .faq__item[open] .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  .faq__answer {
    padding-bottom: 1.3rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-ink) 66%, transparent);
    max-width: 62ch;
  }
  .faq__answer p + p {
    margin-top: 0.75rem;
  }
  .faq__item[open] .faq__answer {
    animation: faq-reveal 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 64rem) {
    .faq__inner {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dúvidas frequentes",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "ID da âncora", "default": "faq" },
    { "type": "text", "id": "eyebrow", "label": "Texto de destaque", "default": "Perguntas frequentes" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Dúvidas frequentes" },
    { "type": "textarea", "id": "description", "label": "Descrição" },
    { "type": "text", "id": "cta_label", "label": "Texto do botão" },
    { "type": "url", "id": "cta_url", "label": "Link do botão" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pergunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pergunta", "default": "Pergunta" },
        { "type": "richtext", "id": "answer", "label": "Resposta" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dúvidas frequentes",
      "blocks": [{ "type": "faq" }, { "type": "faq" }, { "type": "faq" }, { "type": "faq" }]
    }
  ]
}
{% endschema %}
